{
  "name": "factorfox-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-routes.mjs && next build && node scripts/postbuild.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:routes": "node scripts/verify-routes.mjs",
