# Measurement. Leave unset and analytics stays completely dark, including the
# consent banner, which is the state the site launches in.
NEXT_PUBLIC_GA_ID=

# Demonstration request delivery. Any one of these is enough. If none is set
# the lead is still written to the structured log, and the log is the record
# of last resort.
LEAD_WEBHOOK_URL=
LEAD_NOTIFY_TEAMS_WEBHOOK=
LEAD_NOTIFY_EMAIL=
LEAD_MAIL_ENDPOINT=
LEAD_MAIL_TOKEN=
